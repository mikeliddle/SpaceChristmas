@page
@model IndexModel
@{
    ViewData["Title"] = "Join a crew";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <form id="joinForm" class="mx-auto" style="max-width: 24rem;">
        <div class="form-group">
            <label for="group-code-input">Crew invite code</label>
            <input type="text" class="form-control text-center" id="group-code-input" autocomplete="off" required />
        </div>
        <button type="submit" class="btn btn-primary">Join crew</button>
        <p id="joinError" class="text-warning mt-3" role="alert" hidden></p>
    </form>
    <div id="stations" class="dropdown" hidden>
        <button class="btn btn-outline-light dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            Select Your Position
        </button>
        <ul class="dropdown-menu">
            <li><a class="nav-link text-dark" href="/Captain">Captain</a></li>
            <li><a class="nav-link text-dark" href="/Captain">First Officer</a></li>
            <li><a class="nav-link text-dark" href="/RightWing">Right Wing</a></li>
            <li><a class="nav-link text-dark" href="/Engineering">Engineer 1</a></li>
            <li><a class="nav-link text-dark" href="/LeftWing">Engineer 2</a></li>
            <li><a class="nav-link text-dark" href="/Communications">Communications</a></li>
            <li><a class="nav-link text-dark" href="/Security">Security</a></li>
        </ul>
    </div>
    <p class="mt-4"><a asp-page="/Admin/Login" class="text-light">Admin login</a></p>
</div>

<script src="~/js/Index.js" asp-append-version="true"></script>
